    "rolling_average": "gen_throughput_rolling_mean",
    "xgboost": "xgb_prediction"
}

validation_scores = []

for server, group in validation_results.groupby("server_id"):
    for strategy, prediction_col in strategies.items():
        valid = group.dropna(
            subset=["future_throughput", prediction_col]
        )

        mae = mean_absolute_error(
            valid["future_throughput"],
            valid[prediction_col]
        )

        validation_scores.append({
            "server_id": server,
            "strategy": strategy,
            "MAE": mae
        })

validation_scores = pd.DataFrame(validation_scores)

print(validation_scores.pivot(
