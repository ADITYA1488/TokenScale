model_data = aligned.dropna(
    subset=["future_throughput"]
).copy()

model_data = model_data.sort_values("ts").reset_index(drop=True)

split_index = int(len(model_data) * 0.8)

train_data = model_data.iloc[:split_index].copy()
test_data = model_data.iloc[split_index:].copy()

print("Training records:", len(train_data))
print("Testing records:", len(test_data))

print("Training ends:", train_data["ts"].max())
print("Testing starts:", test_data["ts"].min())


model_data = model_data.sort_values(
    ["server_id", "ts"]
).copy()

model_data["position"] = (
    model_data.groupby("server_id").cumcount()
)

model_data["server_size"] = (
    model_data.groupby("server_id")["ts"].transform("size")
)

model_data["split_point"] = (
    model_data["server_size"] * 0.8
).astype(int)

train_data = model_data[
    model_data["position"] < model_data["split_point"] - 1
].copy()

test_data = model_data[
    model_data["position"] >= model_data["split_point"]
].copy()

print("Training records:", len(train_data))
print("Testing records:", len(test_data))

print("\nPer-server split:")
for server in model_data["server_id"].unique():
    tr = train_data[train_data["server_id"] == server]
    te = test_data[test_data["server_id"] == server]

    print(
        server,
        "| Train:", len(tr),
        "| Test:", len(te),
        "| Train ends:", tr["ts"].max(),
        "| Test starts:", te["ts"].min()
    )


features = [
    "gen_throughput_previous",
    "gen_throughput_rolling_mean",
    "running_previous",
    "running_rolling_mean",
    "queued_previous",
    "queued_rolling_mean",
    "ttft_avg_s_previous",
    "e2e_latency_avg_s_previous",
    "gpu_util_mean",
    "gpu_util_max",
    "vram_mean",
    "memory_bandwidth_mean",
    "gpu_power_mean",
    "cpu_util_pct",
    "memory_used_ratio",
    "total_tokens_avg",
    "cache_usage_ratio"
]

target = "future_throughput"

print("Selected features:", len(features))
print("Target:", target)

print("\nMissing training values:")
print(train_data[features].isna().sum())


from sklearn.impute import SimpleImputer
from sklearn.pipeline import Pipeline
from xgboost import XGBRegressor

X_train = train_data[features]
y_train = train_data[target]

X_test = test_data[features]
y_test = test_data[target]

model = Pipeline([
    ("imputer", SimpleImputer(strategy="median")),
    ("regressor", XGBRegressor(
        n_estimators=150,
        max_depth=3,
        learning_rate=0.05,
        subsample=0.8,
        colsample_bytree=0.8,
        objective="reg:squarederror",
        random_state=42
    ))
])

print("Training records:", X_train.shape)
print("Testing records:", X_test.shape)
print("Pipeline prepared.")


aligned = pd.merge_asof(
    sg_features.sort_values("ts"),
    gpu_node.sort_values("ts"),
    on="ts",
    by="node_id",
    direction="backward",
    tolerance=pd.Timedelta(seconds=90)
)

aligned = pd.merge_asof(
    aligned.sort_values("ts"),
