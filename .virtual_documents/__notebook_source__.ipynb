import requests
import pandas as pd
import json
import os
from datetime import datetime, timezone

BASE_URL = "https://openinfra.freeinference.org/api"

response = requests.get(
    f"{BASE_URL}/history",
    params={"hours": 2},
    timeout=30
)

response.raise_for_status()
telemetry = response.json()

print("Collection timestamp:", datetime.now(timezone.utc))
print("Available datasets:", list(telemetry.keys()))
print("Sampling interval (ms):", telemetry.get("grain_ms"))


for name in ["gpu", "sglang", "cpu"]:
    df = pd.DataFrame(telemetry[name])

    print(f"\n{name.upper()}")
    print("Shape:", df.shape)
    print("Columns:", df.columns.tolist())
    print(df.head(2).to_string(index=False))


gpu_df = pd.DataFrame(telemetry["gpu"])
sglang_df = pd.DataFrame(telemetry["sglang"])
cpu_df = pd.DataFrame(telemetry["cpu"])

gpu_df.to_csv("data/raw/gpu_history.csv", index=False)
sglang_df.to_csv("data/raw/sglang_history.csv", index=False)
cpu_df.to_csv("data/raw/cpu_history.csv", index=False)

with open("data/raw/collection_info.json", "w") as f:
    json.dump({
        "generated_at": telemetry["generated_at"],
        "grain_ms": telemetry["grain_ms"],
        "from_cache": telemetry["from_cache"],
        "collected_at": datetime.now(timezone.utc).isoformat()
    }, f, indent=4)

