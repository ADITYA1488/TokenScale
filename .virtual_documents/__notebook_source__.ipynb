print("Testing period:", test_data["ts"].min(), "to", test_data["ts"].max())


model.fit(X_train, y_train)

predictions = model.predict(X_test)

print("XGBoost training completed.")
print("Predictions generated:", len(predictions))
print("Sample predictions:", predictions[:10].round(2))


import numpy as np
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

baseline_predictions = test_data["gen_throughput_previous"].to_numpy()

def evaluate(name, actual, predicted):
    print(f"\n{name}")
    print("MAE:", round(mean_absolute_error(actual, predicted), 2))
    print("RMSE:", round(np.sqrt(mean_squared_error(actual, predicted)), 2))
    print("R2:", round(r2_score(actual, predicted), 4))

evaluate("XGBoost", y_test, predictions)
evaluate("Persistence Baseline", y_test, baseline_predictions)


results = test_data[
    ["server_id", "ts", "gen_throughput", "future_throughput"]
].copy()

results["xgb_prediction"] = predictions
results["baseline_prediction"] = baseline_predictions

results["xgb_error"] = (
    results["future_throughput"] - results["xgb_prediction"]
)

results["baseline_error"] = (
    results["future_throughput"] - results["baseline_prediction"]
)

print(
    results.groupby("server_id").agg(
        actual_mean=("future_throughput", "mean"),
        xgb_mae=("xgb_error", lambda x: x.abs().mean()),
        baseline_mae=("baseline_error", lambda x: x.abs().mean()),
        actual_max=("future_throughput", "max")
    ).round(2)
)


for server, group in train_data.groupby("server_id"):
    print(f"\n{server}")

    print(
        group["future_throughput"]
        .describe(percentiles=[0.5, 0.9, 0.95, 0.99])
        .round(2)
    )

    print(
        "Zero throughput:",
        (group["future_throughput"] == 0).sum()
    )


results["rolling_prediction"] = (
    test_data["gen_throughput_rolling_mean"].to_numpy()
)

for server, group in results.groupby("server_id"):
    print(f"\n{server}")

    actual = group["future_throughput"]

    for name, prediction in [
        ("Persistence", group["baseline_prediction"]),
        ("Rolling average", group["rolling_prediction"]),
        ("XGBoost", group["xgb_prediction"])
    ]:
        mae = mean_absolute_error(actual, prediction)
        print(f"{name} MAE: {mae:.2f}")


for server, group in results.groupby("server_id"):
    baseline_mae = mean_absolute_error(
        group["future_throughput"],
        group["baseline_prediction"]
    )

    print(f"\n{server}")

    for name, column in [
        ("Rolling average", "rolling_prediction"),
        ("XGBoost", "xgb_prediction")
    ]:
        candidate_mae = mean_absolute_error(
            group["future_throughput"],
            group[column]
        )

        improvement = (
            (baseline_mae - candidate_mae) / baseline_mae * 100
            if baseline_mae > 0 else 0
        )

        print(f"{name}: {improvement:.2f}% improvement")


selected_models = {
    "h200a-glm53-flash": "persistence",
    "h200a-replica-a": "rolling_average",
    "rtx6000b-bge-m3": "idle_baseline",
    "rtx6000b-qwen36": "xgboost"
}

results["selected_prediction"] = np.nan

for server, strategy in selected_models.items():
    mask = results["server_id"] == server

    if strategy == "persistence":
        results.loc[mask, "selected_prediction"] = (
            results.loc[mask, "baseline_prediction"]
        )

    elif strategy == "rolling_average":
        results.loc[mask, "selected_prediction"] = (
            results.loc[mask, "rolling_prediction"]
        )

    elif strategy == "idle_baseline":
        results.loc[mask, "selected_prediction"] = 0

    elif strategy == "xgboost":
        results.loc[mask, "selected_prediction"] = (
            results.loc[mask, "xgb_prediction"]
        )

print("Adaptive model selection:")
print(results.groupby("server_id").apply(
    lambda g: mean_absolute_error(
        g["future_throughput"],
        g["selected_prediction"]
    ),
    include_groups=False
))


results.to_csv("outputs/forecasting_results.csv", index=False)

import json

with open("outputs/selected_models.json", "w") as f:
    json.dump(selected_models, f, indent=4)

print("Forecasting results and selected strategies saved.")


for server, group in model_data.groupby("server_id"):
    group = group.sort_values("ts")
    split = int(len(group) * 0.6)
