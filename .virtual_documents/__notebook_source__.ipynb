import { useState } from "react";
import ReactECharts from "echarts-for-react";
import {
  Activity, Cpu, Database, Gauge, Layers3, Network,
  Settings2, ShieldAlert, Zap, ChevronDown, ArrowUpRight,
  CircleDot, Command, BrainCircuit, Server, Clock3
} from "lucide-react";

const navigation = [
  { label: "Command Center", icon: Command },
  { label: "Telemetry", icon: Activity },
  { label: "Forecasting", icon: BrainCircuit },
  { label: "Diagnostics", icon: ShieldAlert },
  { label: "Optimizer", icon: Gauge },
  { label: "Simulation", icon: Layers3 },
  { label: "Experiments", icon: Database }
];

const throughputOption = {
  backgroundColor: "transparent",
  tooltip: { trigger: "axis" },
  grid: { left: 38, right: 15, top: 20, bottom: 28 },
  xAxis: {
    type: "category",
    boundaryGap: false,
    data: ["18:40", "18:55", "19:10", "19:25", "19:40", "19:55", "20:10", "20:25"],
    axisLabel: { color: "#748291", fontSize: 10 },
    axisLine: { lineStyle: { color: "#283440" } }
  },
  yAxis: {
    type: "value",
    name: "tokens/s",
    nameTextStyle: { color: "#748291" },
    axisLabel: { color: "#748291", fontSize: 10 },
    splitLine: { lineStyle: { color: "#202B35", type: "dashed" } }
  },
  series: [
    {
      name: "Measured",
      type: "line",
      smooth: 0.35,
      symbol: "none",
      data: [230, 265, 248, 310, 286, 340, 304, 325],
      lineStyle: { color: "#C7F36B", width: 2.5 },
      areaStyle: { color: "rgba(199,243,107,0.09)" }
    },
    {
      name: "Forecast",
      type: "line",
      smooth: 0.35,
      symbol: "none",
      data: [null, null, null, null, null, 340, 315, 332],
      lineStyle: { color: "#79A9FF", width: 2, type: "dashed" }
    }
  ]
};

function Metric({ label, value, unit, icon: Icon, note }: any) {
  return (
    <div className="metric panel">
      <div className="metric-top">
        <span>{label}</span>
        <Icon size={16} />
      </div>
      <div className="metric-value">{value}<small>{unit}</small></div>
      <div className="metric-note">{note}</div>
    </div>
  );
}

function App() {
  const [active, setActive] = useState("Command Center");
  const [budget, setBudget] = useState(10);
  const [allocation, setAllocation] = useState(4);

  return (
    <div className="app-shell">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-icon"><Activity size={21}/></div>
          <div>
            <div className="brand-name">TOKENSCALE</div>
            <div className="brand-sub">INFERENCE CONTROL</div>
          </div>
        </div>

        <div className="nav-caption">WORKSPACE</div>
        <nav>
          {navigation.map(({ label, icon: Icon }) => (
            <button
              key={label}
              className={`nav-item ${active === label ? "active" : ""}`}
              onClick={() => setActive(label)}
            >
              <Icon size={17}/>
              <span>{label}</span>
              {active === label && <span className="nav-indicator"/>}
            </button>
          ))}
        </nav>

        <div className="sidebar-bottom">
          <div className="connection"><span className="live-dot"/> API CONNECTION</div>
          <div className="connection-detail">Backend integration pending</div>
          <button className="nav-item settings"><Settings2 size={17}/> Settings</button>
          <div className="version">TOKENSCALE / BUILD 0.1.0</div>
        </div>
      </aside>

      <main className="main-area">
        <header className="topbar">
          <div className="breadcrumb">WORKSPACE <span>/</span> {active.toUpperCase()}</div>
          <div className="top-actions">
            <div className="environment"><span className="live-dot"/> SIMULATION ENVIRONMENT</div>
            <div className="avatar">TS</div>
          </div>
        </header>

        <div className="content">
          <section className="page-heading">
            <div>
              <div className="eyebrow">INFRASTRUCTURE / 01</div>
              <h1>{active}</h1>
              <p>Monitor, diagnose and optimize LLM inference infrastructure.</p>
            </div>
            <button className="date-button"><Clock3 size={14}/> Last 2 hours <ChevronDown size={14}/></button>
          </section>

          <section className="status-strip">
            <div><span className="live-dot"/> SYSTEM OPERATIONAL</div>
            <span>4 NODES REGISTERED</span>
            <span>TELEMETRY SNAPSHOT</span>
            <span className="status-right">DECISION ENGINE <b>READY</b></span>
          </section>

          <section className="metrics-grid">
            <Metric label="AGGREGATE THROUGHPUT" value="1,024" unit=" tok/s" icon={Zap} note="Across observed inference nodes"/>
            <Metric label="GPU COMPUTE" value="81.7" unit="%" icon={Cpu} note="Mean utilization · observed"/>
            <Metric label="REGISTERED NODES" value="04" unit="/ 04" icon={Server} note="Nodes in current dataset"/>
            <Metric label="SLO ALERTS" value="02" unit="" icon={ShieldAlert} note="Latency investigation required"/>
          </section>

          <section className="primary-grid">
            <div className="panel chart-panel">
              <div className="section-heading">
                <div>
                  <div className="eyebrow">PERFORMANCE / 001</div>
                  <h2>Inference throughput</h2>
                </div>
                <div className="chart-legend">
                  <span><i className="legend-measured"/>Measured</span>
                  <span><i className="legend-forecast"/>Forecast</span>
                </div>
              </div>
              <ReactECharts option={throughputOption} style={{ height: 260 }} notMerge={true}/>
              <div className="chart-foot"><span>HISTORICAL OBSERVATIONS</span><span>UNIT: TOKENS / SECOND</span></div>
            </div>

            <div className="panel health-panel">
              <div className="eyebrow">RESOURCE HEALTH / 002</div>
              <h2>Compute overview</h2>
              <div className="health-item">
                <div className="health-title"><span>GPU utilization</span><b>81.7%</b></div>
                <div className="progress"><i style={{width:"81.7%"}}/></div>
              </div>
              <div className="health-item">
                <div className="health-title"><span>VRAM occupancy</span><b>96.9%</b></div>
                <div className="progress warning"><i style={{width:"96.9%"}}/></div>
              </div>
              <div className="health-item">
                <div className="health-title"><span>CPU utilization</span><b>—</b></div>
                <div className="progress"><i style={{width:"0%"}}/></div>
                <small>Per-node value not displayed</small>
              </div>
              <div className="health-foot"><ShieldAlert size={15}/> High VRAM occupancy — investigate capacity headroom.</div>
            </div>
          </section>

          <section className="bottom-grid">
            <div className="panel nodes-panel">
              <div className="section-heading">
                <div>
                  <div className="eyebrow">INFRASTRUCTURE / 003</div>
                  <h2>Inference nodes</h2>
                </div>
                <span className="table-count">04 NODES</span>
              </div>
              <div className="node-table">
                <div className="table-head"><span>SERVER</span><span>THROUGHPUT</span><span>DIAGNOSIS</span></div>
                {[
                  ["RTX6000B / QWEN36","304.5","MONITOR","good"],
                  ["RTX6000B / BGE-M3","0.0","INACTIVE","muted"],
                  ["H200 / GLM53","169.7","INVESTIGATE","warn"],
                  ["H200 / REPLICA","256.4","INVESTIGATE","warn"]
                ].map(row => (
                  <div className="table-row" key={row[0]}>
                    <span className="node-name"><CircleDot size={13}/>{row[0]}</span>
                    <span className="mono">{row[1]} <small>tok/s</small></span>
                    <span className={`node-status ${row[3]}`}>{row[2]}</span>
                  </div>
                ))}
              </div>
            </div>

            <div className="panel optimizer-panel">
              <div className="eyebrow">DECISION ENGINE / 004</div>
              <h2>Allocation workbench</h2>
              <p>Configure the capacity constraints for a hypothetical optimization run.</p>
              <div className="slider-label"><span>Capacity budget</span><b>{budget} units</b></div>
              <input type="range" min="1" max="20" value={budget} onChange={e=>setBudget(Number(e.target.value))}/>
              <div className="slider-label"><span>Maximum per node</span><b>{allocation} units</b></div>
              <input type="range" min="1" max="10" value={allocation} onChange={e=>setAllocation(Number(e.target.value))}/>
              <button className="optimize-button" onClick={()=>setActive("Optimizer")}>
                <Zap size={15}/> OPEN OPTIMIZER <ArrowUpRight size={15}/>
              </button>
              <div className="optimizer-note"><Network size={13}/> SIMULATION ONLY · NO INFRASTRUCTURE CHANGES</div>
            </div>
          </section>

          <footer>
            <span>TOKENSCALE © 2026</span>
            <span>MEASURED TELEMETRY + EXPERIMENTAL SIMULATION</span>
            <span>ENGINE STATUS: READY</span>
          </footer>
        </div>
      </main>
    </div>
  );
}

export default App;
""".strip() + "\n")

