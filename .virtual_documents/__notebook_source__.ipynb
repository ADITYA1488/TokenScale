code = '''
from scipy.optimize import linprog
import numpy as np


def optimize_allocation(
    servers,
    capacity_budget,
    max_units_per_server
):
    eligible = [
        server for server in servers
        if server["currently_feasible"]
        and server["baseline_throughput"] > 0
    ]

    if not eligible:
        return {
            "success": True,
            "allocations": {},
            "unused_capacity": capacity_budget
        }

    scores = np.array([
        server["baseline_throughput"]
        * server["simulated_gain_per_unit"]
        / (1 + server.get("diagnostic_score", 0) / 100)
        for server in eligible
    ])

    result = linprog(
        c=-scores,
        A_ub=[np.ones(len(eligible))],
        b_ub=[capacity_budget],
        bounds=[(0, max_units_per_server)] * len(eligible),
        method="highs"
    )

    if not result.success:
        raise RuntimeError(result.message)

    allocations = {
        server["server_id"]: float(units)
        for server, units in zip(eligible, result.x)
    }

    return {
        "success": True,
        "allocations": allocations,
        "unused_capacity": float(
            capacity_budget - result.x.sum()
        )
    }
'''

