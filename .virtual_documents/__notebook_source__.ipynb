sg_features = sglang_clean.copy()

sg_features["total_tokens_avg"] = (
    sg_features["prompt_tokens_avg"] +
    sg_features["generation_tokens_avg"]
)

sg_features["queue_per_running"] = (
    sg_features["queued"] /
    sg_features["running"].clip(lower=1)
)

sg_features["cache_usage_ratio"] = (
    sg_features["used_tokens"] /
    sg_features["max_tokens"].replace(0, float("nan"))
)

sg_features["timestamp_hour"] = (
    sg_features["ts"].dt.hour
)

print("Feature dataset:", sg_features.shape)
print(sg_features[[
    "server_id",
    "total_tokens_avg",
    "queue_per_running",
    "cache_usage_ratio",
    "timestamp_hour"
]].head())


sg_features = sg_features.sort_values(
    ["server_id", "ts"]
).copy()

history_metrics = [
    "gen_throughput",
    "running",
    "queued",
    "ttft_avg_s",
    "e2e_latency_avg_s",
    "token_usage"
]

for col in history_metrics:
    sg_features[f"{col}_previous"] = (
        sg_features.groupby("server_id")[col].shift(1)
    )

    sg_features[f"{col}_rolling_mean"] = (
        sg_features.groupby("server_id")[col]
        .transform(lambda x: x.shift(1).rolling(3, min_periods=1).mean())
    )

print("Historical features created.")
print("Shape:", sg_features.shape)

print(sg_features[[
    "server_id",
    "ts",
    "gen_throughput",
    "gen_throughput_previous",
    "gen_throughput_rolling_mean"
]].head(10).to_string(index=False))


gpu_features = gpu_clean.copy()
cpu_features = cpu_clean.copy()

gpu_features["memory_used_proxy_pct"] = gpu_features["memory_pct"]
gpu_features["compute_memory_gap"] = (
    gpu_features["utilization_pct"] -
    gpu_features["memory_util_pct"]
)

cpu_features["memory_used_ratio"] = (
    cpu_features["mem_used_mb"] /
    cpu_features["mem_total_mb"]
)

cpu_features["memory_available_ratio"] = (
    cpu_features["mem_available_mb"] /
    cpu_features["mem_total_mb"]
)

print("GPU features:", gpu_features.shape)
print("CPU features:", cpu_features.shape)

print("\nGPU feature sample:")
print(gpu_features[[
    "gpu_id", "utilization_pct",
    "memory_used_proxy_pct", "compute_memory_gap"
]].head())

print("\nCPU feature sample:")
print(cpu_features[[
    "node_id", "cpu_util_pct",
    "memory_used_ratio", "memory_available_ratio"
]].head())


gpu_node = (
    gpu_features.groupby(["node_id", "ts"])
    .agg(
        gpu_util_mean=("utilization_pct", "mean"),
        gpu_util_max=("utilization_pct", "max"),
        vram_mean=("memory_pct", "mean"),
        memory_bandwidth_mean=("memory_util_pct", "mean"),
        gpu_power_mean=("power_w", "mean"),
        gpu_count=("gpu_id", "nunique")
    )
    .reset_index()
)

cpu_node = cpu_features[[
    "node_id", "ts", "cpu_util_pct",
    "memory_used_ratio", "memory_available_ratio"
]].copy()

aligned = pd.merge_asof(
    sg_features.sort_values("ts"),
    gpu_node.sort_values("ts"),
    on="ts",
    by="node_id",
    direction="nearest",
    tolerance=pd.Timedelta(seconds=90)
)

aligned = pd.merge_asof(
    aligned.sort_values("ts"),
    cpu_node.sort_values("ts"),
    on="ts",
    by="node_id",
    direction="nearest",
    tolerance=pd.Timedelta(seconds=90)
)

print("Aligned dataset:", aligned.shape)
print("\nHardware coverage:")
print(aligned[[
    "gpu_util_mean",
    "vram_mean",
    "cpu_util_pct"
]].notna().mean().round(3))


