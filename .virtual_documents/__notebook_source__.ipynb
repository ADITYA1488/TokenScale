from langgraph.graph import StateGraph, START, END

from src.agents.workflow_state import TokenScaleState
from src.agents.validation_node import validation_node
from src.agents.simulation_node import simulation_node
from src.agents.explanation_node import explanation_node
from src.agents.workflow import route_after_validation


def force_invalid_allocation(state):
    return {"allocations": {"rtx6000b-qwen36": 6}}


test_builder = StateGraph(TokenScaleState)

test_builder.add_node("force_invalid", force_invalid_allocation)
test_builder.add_node("validation", validation_node)
test_builder.add_node("simulation", simulation_node)
test_builder.add_node("explanation", explanation_node)

test_builder.add_edge(START, "force_invalid")
test_builder.add_edge("force_invalid", "validation")

test_builder.add_conditional_edges(
    "validation",
    route_after_validation,
    {
        "simulation": "simulation",
        "explanation": "explanation"
    }
)

test_builder.add_edge("simulation", "explanation")
test_builder.add_edge("explanation", END)

test_graph = test_builder.compile()

test_result = test_graph.invoke({
    "capacity_budget": 10,
    "max_units_per_server": 4,
    "errors": []
})

print("Validation:", test_result["validation"])
print("Simulation results present:", "simulation_results" in test_result)
print(test_result["explanation"])

assert test_result["validation"]["valid"] is False
assert "simulation_results" not in test_result

print("\nInvalid-allocation routing test passed.")


