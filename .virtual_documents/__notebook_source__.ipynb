def classify_server(row):
    if row["gen_throughput"] == 0 and row["running"] == 0:
        return "No observed inference workload"

    if (
        row["gpu_util_mean"] >= 90
        and row["vram_mean"] >= 90
        and row["queued"] > 0
    ):
        return "Potential GPU and memory pressure"

    if row["gpu_util_mean"] >= 90 and row["queued"] == 0:
        return "High GPU utilization without queue"

    if row["queued"] > 0:
        return "Queue pressure; investigate"

    return "No immediate pressure signal"


