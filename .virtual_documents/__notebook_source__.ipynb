code = '''
def explanation_node(state):
    lines = [
        "TokenScale Infrastructure Decision Report",
        "=" * 42,
        "",
        "Server Diagnosis:"
    ]

    for item in state["diagnosis"]:
        lines.append(
            f"- {item['server_id']}: {item['recommended_action']}"
        )

    lines.append("")
    lines.append("Throughput Forecasts:")

    for item in state["forecasts"]:
        lines.append(
            f"- {item['server_id']}: "
            f"{item['predicted_next_throughput']} tokens/s "
            f"({item['forecast_method']})"
        )

    lines.extend([
        "",
        "Resource Allocation:",
        str(state["allocations"]),
        "",
        "Validation:",
        str(state["validation"]),
        "",
        "Simulation Results:"
    ])

    for item in state["simulation_results"]:
        lines.append(
            f"- {item['server_id']}: "
            f"{item['baseline_throughput']} -> "
            f"{item['simulated_throughput']} tokens/s "
            f"(simulated gain: {item['simulated_gain']})"
        )

    lines.extend([
        "",
        "Note: Throughput improvements are hypothetical "
        "and depend on the configured gain assumptions."
    ])

    return {"explanation": "\\n".join(lines)}
'''

